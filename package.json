{
  "name": "nasa-sac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/check-team.ts && bun test src/lib/describe && next build",
    "start": "python pipeline/health/static_server.py out 3000",
    "shadd": "bunx --bun shadcn@latest add",
    "lint": "eslint",
    "test": "bun test",
    "e2e": "playwright test",
    "health": "cd pipeline && python -m health --app",
    "refresh:live": "cd pipeline && python refresh_live.py",
    "check:team": "bun scripts/check-team.ts",
    "listen-test:summary": "bun scripts/listen-test-summary.ts",
    "i18n:todo": "UPDATE_TO_TRANSLATE=1 bun test src/lib/i18n/i18n.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-geospatial": "0.9.1",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "maath": "0.10.8",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "astronomy-engine": "2.1.19",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fflate": "^0.8.3",
    "ktx2-encoder": "0.6.0",
    "mapshaper": "0.7.98",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.8",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
