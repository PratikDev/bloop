# Ask Bloop's LLM fallback (docs/voice/README.md). OFF: the app calls it only when built with NEXT_PUBLIC_ASK_BLOOP_LLM=1,
# and it runs only where deployed as a server function with these set (server side; never NEXT_PUBLIC_). Any
# OpenAI-compatible chat-completions endpoint. Set a hard spending cap in the provider's dashboard for any paid key.
ASK_BLOOP_BASE_URL=
ASK_BLOOP_MODEL=
ASK_BLOOP_API_KEY=
# Optional: tried once on 429, 5xx or a timeout.
ASK_BLOOP_FALLBACK_BASE_URL=
ASK_BLOOP_FALLBACK_MODEL=
ASK_BLOOP_FALLBACK_API_KEY=
